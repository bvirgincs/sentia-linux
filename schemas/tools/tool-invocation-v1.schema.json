{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentia.local/schemas/tools/tool-invocation-v1.schema.json",
  "title": "Sentia Structured Tool Invocation v1",
  "description": "Shared typed invocation/result envelope for registered tools.",
  "$defs": {
    "tool_name": {
      "$ref": "tool-registry-v1.schema.json#/$defs/tool_name"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "timestamp_ms"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["router", "cli", "ui", "system_task"]
        },
        "timestamp_ms": { "type": "integer", "minimum": 0 },
        "request_id": { "type": "string", "maxLength": 64 }
      }
    },
    "evidence_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["command", "log", "json", "snapshot", "checksum"]
        },
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "contract_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "unsupported_version",
            "permission_denied",
            "policy_denied",
            "payload_too_large",
            "timeout",
            "cancelled",
            "provider_unavailable",
            "tool_unavailable",
            "validation_failed",
            "internal"
          ]
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "tool_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_id",
        "name",
        "args",
        "max_input_bytes",
        "provenance"
      ],
      "properties": {
        "version": { "type": "string", "const": "sentia.v1" },
        "request_id": { "type": "string", "maxLength": 64 },
        "name": { "$ref": "#/$defs/tool_name" },
        "args": {},
        "max_input_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_id",
        "name",
        "status",
        "data",
        "max_output_bytes",
        "duration_ms",
        "truncated"
      ],
      "properties": {
        "version": { "type": "string", "const": "sentia.v1" },
        "request_id": { "type": "string", "maxLength": 64 },
        "name": { "$ref": "#/$defs/tool_name" },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "unavailable",
            "permission_denied",
            "timeout",
            "failed",
            "cancelled"
          ]
        },
        "data": {},
        "max_output_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 262144
        },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "error": { "$ref": "#/$defs/contract_error" },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/evidence_pointer" }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/tool_request" },
    { "$ref": "#/$defs/tool_result" }
  ]
}
