# Sentia local llama.cpp runtime defaults.
# No provider API keys are configured here by design.
SENTIA_MODEL_PATH=/usr/share/sentia/models/granite-4.2-3b/granite-4.2-3b-Q4_K_M.gguf
SENTIA_SOCKET_PATH=/run/sentia-inference/llama.sock
SENTIA_CTX_SIZE=8192
SENTIA_N_PARALLEL=1
SENTIA_MAX_PREDICT=256
# Granite 4.2 is a reasoning model and its template enables thinking by default,
# which puts the answer in message.reasoning_content and leaves message.content
# empty whenever the token budget runs out mid-thought. Sentia asks short,
# concrete system questions on a CPU-only machine, so thinking is off by
# default. Set to "on" or "auto" if a future default model benefits from it.
SENTIA_REASONING=off
SENTIA_THREADS=4
SENTIA_THREADS_BATCH=4
SENTIA_THREADS_HTTP=2
SENTIA_BATCH_SIZE=512
SENTIA_UBATCH_SIZE=256
SENTIA_TIMEOUT_SECONDS=60
SENTIA_SLEEP_IDLE_SECONDS=300
SENTIA_ENABLE_METRICS=1
SENTIA_LOG_VERBOSITY=1
