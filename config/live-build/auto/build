#!/usr/bin/env bash
set -euo pipefail

: "${SOURCE_DATE_EPOCH:?SOURCE_DATE_EPOCH must be set}"
export SOURCE_DATE_EPOCH
export MAKEFLAGS="${MAKEFLAGS:--j2}"

# Path inside the live-build chroot; kept in sync with build/scripts/iso.sh.
build_archive_path="/srv/sentia-build-archive"

overlay_source="$(pwd)/sentia-overlay-archive"
overlay_keyring="$(pwd)/sentia-archive-keyring.gpg"

# `lb build` is expanded into its phases so the signed Sentia overlay can be
# placed inside the live-build chroot. That chroot does not inherit the outer
# builder's bind mounts, so the archive has to be copied in after debootstrap
# and before chroot_archives runs `apt-get update` against it.
lb bootstrap noauto

[[ -d "${overlay_source}" ]] || {
  echo "ERROR: staged overlay archive missing: ${overlay_source}" >&2
  exit 1
}
[[ -f "${overlay_keyring}" ]] || {
  echo "ERROR: staged overlay keyring missing: ${overlay_keyring}" >&2
  exit 1
}

stage_overlay_into() {
  local root="$1"
  [[ -d "${root}" ]] || return 0
  mkdir -p "${root}${build_archive_path}" "${root}/usr/share/keyrings"
  cp -a "${overlay_source}/." "${root}${build_archive_path}/"
  install -m 0644 "${overlay_keyring}" "${root}/usr/share/keyrings/sentia-archive-keyring.gpg"
}

stage_overlay_into chroot

# lb binary_chroot replaces chroot/ with a pristine copy of cache/bootstrap and
# nests the real rootfs at chroot/chroot. It then reinstalls the chroot-mode apt
# sources and runs apt in that pristine copy, so the overlay has to be present
# there as well or the binary stage fails on a missing Release file.
stage_overlay_into cache/bootstrap

lb chroot noauto

# live-build's bootstrap stage copies Debian's /usr/lib/os-release to a real
# /etc/os-release file and dpkg-diverts it, so that later package upgrades
# cannot change it. That happens before sentia-base-files exists, which leaves
# the booted system reporting Debian's identity from /etc/os-release while
# /usr/lib/os-release correctly says Sentia. chroot_hacks removes the divert at
# the end of the chroot stage but never restores the symlink, so restore the
# layout Debian's base-files actually ships. The live image metadata that
# live-build appended is re-applied to the canonical file.
restore_os_release_symlink() {
  local root="$1"
  [[ -f "${root}/usr/lib/os-release" ]] || return 0
  if [[ -f "${root}/etc/os-release" && ! -L "${root}/etc/os-release" ]]; then
    local key
    for key in IMAGE_ID BUILD_ID; do
      local line
      line="$(grep "^${key}=" "${root}/etc/os-release" || true)"
      if [[ -n "${line}" ]] && ! grep -q "^${key}=" "${root}/usr/lib/os-release"; then
        printf '%s\n' "${line}" >> "${root}/usr/lib/os-release"
      fi
    done
    rm -f "${root}/etc/os-release"
    ln -s ../usr/lib/os-release "${root}/etc/os-release"
  fi
}

restore_os_release_symlink chroot


# The archive deliberately stays in the chroot here. `lb binary` reinstalls the
# chroot-mode apt sources (mode-archives-chroot) before building the squashfs,
# so removing it at this point makes the binary stage fail on a dangling file:
# source. config/rootfs/excludes keeps both out of the shipped filesystem
# instead; installed systems get their local archive from
# sentia-offline-repository.
lb installer noauto
lb binary noauto
