{
  "version": 1,
  "listen_socket": "/run/sentia-local/broker.sock",
  "backend_socket": "/run/sentia-inference/llama.sock",
  "backend_model": "sentia-local",
  "minimum_peer_uid": 1000,
  "maximum_peer_uid": 60000,
  "max_active": 1,
  "max_global_queue": 16,
  "max_queue_per_uid": 2,
  "max_request_bytes": 1048576,
  "max_messages": 64,
  "max_prompt_bytes": 524288,
  "max_generation_tokens": 2048,
  "backend_connect_timeout_ms": 30000,
  "backend_request_timeout_ms": 180000
}
