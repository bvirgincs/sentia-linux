#!/bin/sh
set -eu

for app in sentia-system-monitor xfce4-taskmanager gnome-system-monitor mate-system-monitor; do
    if command -v "$app" >/dev/null 2>&1; then
        exec "$app" "$@"
    fi
done

if command -v xmessage >/dev/null 2>&1; then
    xmessage -center "Sentia System Monitor is not available in this build yet."
fi

exit 0
