<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="single-workspace-mode" type="bool" value="true"/>
    <property name="screen0" type="empty">
      <!-- xfdesktop keys the backdrop on the connector name, so monitor0 alone
           never matched: a QEMU guest reports Virtual-1 and real hardware
           reports eDP-1, HDMI-A-1 and so on. The desktop-background alternative
           registered by this package covers the names not listed here. -->
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/sentia/sentia-wallpaper.svg"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
      <property name="monitorVirtual-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/sentia/sentia-wallpaper.svg"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
</channel>
