[Unit]
Description=Sentia per-user AI router
Documentation=man:ai(1)
Requires=sentia-router.socket
After=sentia-router.socket

[Service]
Type=simple
ExecStart=/usr/libexec/sentia/sentia-router
Environment=SENTIA_ROUTER_CONFIG=/etc/sentia/router-runtime.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=-%h/.config/sentia
ReadWritePaths=%t/sentia
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @privileged @reboot @resources @swap

# Deliberately no [Install]: sentia-router.socket owns the socket path and is the
# unit that gets enabled. Starting this service from default.target as well gave
# the path two owners, because a service started that way is handed no listening
# file descriptor and binds the path itself.
