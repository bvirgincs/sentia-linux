[Unit]
Description=Sentia isolated provider worker (%i)
Documentation=file:/usr/share/doc/sentia-providers/README.md
# This root-owned marker is deliberately not shipped. The unit must remain
# unavailable until descriptor activation is implemented and tested on Trixie.
ConditionPathExists=/usr/share/sentia/provider-workers-systemd-boundary-qualified
RefuseManualStart=yes

[Service]
Type=exec
ExecStart=/usr/libexec/sentia-provider-worker --provider %i
StandardInput=socket
StandardOutput=socket
StandardError=null

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

# An inherited connected descriptor remains usable after path masking. The
# worker cannot open any AF_UNIX socket, home file, or Sentia runtime socket.
InaccessiblePaths=-%t/sentia

UnsetEnvironment=OPENAI_API_KEY ANTHROPIC_API_KEY GEMINI_API_KEY GOOGLE_API_KEY XAI_API_KEY DEEPSEEK_API_KEY
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy
Environment=RUST_BACKTRACE=0

TasksMax=16
MemoryHigh=192M
MemoryMax=256M
LimitCORE=0
RuntimeMaxSec=10min
TimeoutStartSec=10s
TimeoutStopSec=5s
KillMode=mixed
