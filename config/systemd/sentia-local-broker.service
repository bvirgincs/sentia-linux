[Unit]
Description=Sentia peer-authenticated local inference broker
Documentation=man:ai(1)
Wants=sentia-local-llama.service
After=sentia-local-llama.service

[Service]
Type=simple
User=sentia-inference
Group=sentia-inference
ExecStart=/usr/libexec/sentia/sentia-local-broker
Environment=SENTIA_LOCAL_BROKER_CONFIG=/etc/sentia/local-broker.json
RuntimeDirectory=sentia-local
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
UMask=0022

NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadOnlyPaths=-/run/sentia-inference
ReadWritePaths=/run/sentia-local
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @privileged @reboot @resources @swap
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
