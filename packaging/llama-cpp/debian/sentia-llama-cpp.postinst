#!/bin/sh
set -e

# See sentia-router.postinst: the account is shared and created idempotently by
# whichever of the two packages is configured first.
if [ "$1" = "configure" ]; then
  if ! getent passwd sentia-inference >/dev/null; then
    adduser --system --group --no-create-home \
      --home /nonexistent --shell /usr/sbin/nologin \
      --gecos "Sentia local inference" sentia-inference
  fi
fi

#DEBHELPER#

exit 0
