{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentia.dev/schemas/apt-worker/request.schema.json",
  "title": "Sentia APT Worker Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "operation"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "protocol_version": {
      "type": "string",
      "const": "1.0"
    },
    "version": {
      "oneOf": [
        {
          "type": "integer",
          "const": 1
        },
        {
          "type": "string",
          "enum": [
            "1",
            "1.0"
          ]
        }
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "apt_search",
        "apt_package_info",
        "apt_package_policy",
        "apt_simulate_install",
        "apt_install",
        "apt_remove",
        "apt_update",
        "apt_upgrade",
        "package_owns_file",
        "diagnostics",
        "search",
        "package_info",
        "policy",
        "package_policy",
        "simulate_install",
        "install",
        "remove",
        "update",
        "upgrade",
        "packagefileownership"
      ]
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "version_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "mode": {
          "type": "string",
          "enum": [
            "plan",
            "execute"
          ]
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9+.-]{0,127}$"
          }
        },
        "file_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "index_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "version_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "mode": {
          "type": "string",
          "enum": [
            "plan",
            "execute"
          ]
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9+.-]{0,127}$"
          }
        },
        "file_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "index_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "approval": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "broker_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sessionhash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "broker_session_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authorization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "planid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_utc": {
          "type": "string",
          "format": "date-time"
        },
        "expiry_utc": {
          "type": "string",
          "format": "date-time"
        },
        "utc_expiry": {
          "type": "string",
          "format": "date-time"
        },
        "allow_source_change": {
          "type": "boolean",
          "default": false
        },
        "allow_essential_removal": {
          "type": "boolean",
          "default": false
        },
        "allow_held_change": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "plan_digest"
              ]
            },
            {
              "required": [
                "digest"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "broker_session_id"
              ]
            },
            {
              "required": [
                "session_hash"
              ]
            },
            {
              "required": [
                "sessionhash"
              ]
            },
            {
              "required": [
                "broker_session_hash"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "authorization_id"
              ]
            },
            {
              "required": [
                "plan_id"
              ]
            },
            {
              "required": [
                "planid"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "expires_at"
              ]
            },
            {
              "required": [
                "expires_utc"
              ]
            },
            {
              "required": [
                "expiry_utc"
              ]
            },
            {
              "required": [
                "utc_expiry"
              ]
            }
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "protocol_version"
          ]
        },
        {
          "required": [
            "version"
          ]
        }
      ]
    }
  ]
}
